'M2Leverage.rotation_coefficient_norm' depends on axioms: [propext, Classical.choice, Quot.sound]
'M2Leverage.stress_covariance_contribution_nonpositive' depends on axioms: [propext, Classical.choice, Quot.sound]
'M2Leverage.three_statistics_stock_reconstruction' depends on axioms: [propext, Classical.choice, Quot.sound]
M2Leverage.three_statistics_stock_reconstruction (theta : Real) (v dt dw db logStock : Nat → Real)
  (h0 :
    @Eq Real (logStock (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0))))
      (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero)))
  (hstep :
    ∀ (n : Nat),
      @Eq Real
        (logStock
          (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) n
            (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))))
        (@HAdd.hAdd Real Real Real (@instHAdd Real Real.instAdd)
          (@HSub.hSub Real Real Real (@instHSub Real Real.instSub) (logStock n)
            (@HDiv.hDiv Real Real Real (@instHDiv Real (@DivInvMonoid.toDiv Real Real.instDivInvMonoid))
              (@HMul.hMul Real Real Real (@instHMul Real Real.instMul) (v n) (dt n))
              (@OfNat.ofNat Real (nat_lit 2) (@instOfNatAtLeastTwo Real (nat_lit 2) Real.instNatCast ⋯))))
          (@HMul.hMul Real Real Real (@instHMul Real Real.instMul) (v n).sqrt
            (@HSub.hSub Real Real Real (@instHSub Real Real.instSub)
              (@HMul.hMul Real Real Real (@instHMul Real Real.instMul)
                (@HSub.hSub Real Real Real (@instHSub Real Real.instSub)
                    (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne))
                    (@HPow.hPow Real Nat Real
                      (@instHPow Real Nat (@NPow.toPow Real (@Monoid.toNPow Real Real.instMonoid))) theta
                      (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))).sqrt
                (dw n))
              (@HMul.hMul Real Real Real (@instHMul Real Real.instMul) theta (db n))))))
  (n : Nat) :
  @Eq Real (logStock n)
    (@HSub.hSub Real Real Real (@instHSub Real Real.instSub)
      (@HAdd.hAdd Real Real Real (@instHAdd Real Real.instAdd)
        (@HMul.hMul Real Real Real (@instHMul Real Real.instMul)
          (@Neg.neg Real Real.instNeg
            (@HDiv.hDiv Real Real Real (@instHDiv Real (@DivInvMonoid.toDiv Real Real.instDivInvMonoid))
              (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne))
              (@OfNat.ofNat Real (nat_lit 2) (@instOfNatAtLeastTwo Real (nat_lit 2) Real.instNatCast ⋯))))
          (∑ i ∈ Finset.range n, @HMul.hMul Real Real Real (@instHMul Real Real.instMul) (v i) (dt i)))
        (@HMul.hMul Real Real Real (@instHMul Real Real.instMul)
          (@HSub.hSub Real Real Real (@instHSub Real Real.instSub)
              (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne))
              (@HPow.hPow Real Nat Real (@instHPow Real Nat (@NPow.toPow Real (@Monoid.toNPow Real Real.instMonoid)))
                theta (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))).sqrt
          (∑ i ∈ Finset.range n, @HMul.hMul Real Real Real (@instHMul Real Real.instMul) (v i).sqrt (dw i))))
      (@HMul.hMul Real Real Real (@instHMul Real Real.instMul) theta
        (∑ i ∈ Finset.range n, @HMul.hMul Real Real Real (@instHMul Real Real.instMul) (v i).sqrt (db i))))
