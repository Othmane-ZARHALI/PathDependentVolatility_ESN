M2Calibration.frozen_anchor_control_reuse.{u_1, u_2} {Ω : Type u_1} {Θ : Type u_2} [MeasurableSpace Ω]
  (μ : @Measure Ω inst✝) (n : Nat) (H : Θ → Ω → Real) (C : Fin n → Ω → Real) (beta : Fin n → Real)
  (hH :
    ∀ (θ : Θ),
      @Integrable Real
        (@UniformSpace.toTopologicalSpace Real (@PseudoMetricSpace.toUniformSpace Real Real.pseudoMetricSpace))
        (@ESeminormedAddMonoid.toContinuousENorm Real
          (@UniformSpace.toTopologicalSpace Real (@PseudoMetricSpace.toUniformSpace Real Real.pseudoMetricSpace))
          (@SeminormedAddGroup.toESeminormedAddMonoid Real
            (@SeminormedAddCommGroup.toSeminormedAddGroup Real
              (@NonUnitalSeminormedRing.toSeminormedAddCommGroup Real
                (@NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing Real
                  (@SeminormedCommRing.toNonUnitalSeminormedCommRing Real
                    (@NormedCommRing.toSeminormedCommRing Real Real.normedCommRing)))))))
        Ω inst✝ (H θ) μ)
  (hC :
    ∀ (i : Fin n),
      @Integrable Real
        (@UniformSpace.toTopologicalSpace Real (@PseudoMetricSpace.toUniformSpace Real Real.pseudoMetricSpace))
        (@ESeminormedAddMonoid.toContinuousENorm Real
          (@UniformSpace.toTopologicalSpace Real (@PseudoMetricSpace.toUniformSpace Real Real.pseudoMetricSpace))
          (@SeminormedAddGroup.toESeminormedAddMonoid Real
            (@SeminormedAddCommGroup.toSeminormedAddGroup Real
              (@NonUnitalSeminormedRing.toSeminormedAddCommGroup Real
                (@NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing Real
                  (@SeminormedCommRing.toNonUnitalSeminormedCommRing Real
                    (@NormedCommRing.toSeminormedCommRing Real Real.normedCommRing)))))))
        Ω inst✝ (C i) μ)
  (hzero :
    ∀ (i : Fin n),
      @Eq Real
        (@integral Ω Real Real.normedAddCommGroup
          (@InnerProductSpace.toNormedSpace Real Real Real.instRCLike
            (@NormedAddCommGroup.toSeminormedAddCommGroup Real Real.normedAddCommGroup)
            (@RCLike.toInnerProductSpaceReal Real Real.instRCLike))
          inst✝ μ fun ω => C i ω)
        (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero)))
  (θ : Θ) :
  @Eq Real
    (@integral Ω Real Real.normedAddCommGroup
      (@InnerProductSpace.toNormedSpace Real Real Real.instRCLike
        (@NormedAddCommGroup.toSeminormedAddCommGroup Real Real.normedAddCommGroup)
        (@RCLike.toInnerProductSpaceReal Real Real.instRCLike))
      inst✝ μ fun ω =>
      @HSub.hSub Real Real Real (@instHSub Real Real.instSub) (H θ ω)
        (∑ i, @HMul.hMul Real Real Real (@instHMul Real Real.instMul) (beta i) (C i ω)))
    (@integral Ω Real Real.normedAddCommGroup
      (@InnerProductSpace.toNormedSpace Real Real Real.instRCLike
        (@NormedAddCommGroup.toSeminormedAddCommGroup Real Real.normedAddCommGroup)
        (@RCLike.toInnerProductSpaceReal Real Real.instRCLike))
      inst✝ μ fun ω => H θ ω)
M2Calibration.gaussian_hedge_step_mean_zero (v : NNReal) (stock delta : Real) :
  @Eq Real
    (@integral Real Real Real.normedAddCommGroup
      (@InnerProductSpace.toNormedSpace Real Real Real.instRCLike
        (@NormedAddCommGroup.toSeminormedAddCommGroup Real Real.normedAddCommGroup)
        (@RCLike.toInnerProductSpaceReal Real Real.instRCLike))
      Real.measurableSpace (gaussianReal (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero)) v) fun z =>
      @HMul.hMul Real Real Real (@instHMul Real Real.instMul) delta
        (@HSub.hSub Real Real Real (@instHSub Real Real.instSub)
          (@HMul.hMul Real Real Real (@instHMul Real Real.instMul) stock
            (Real.exp
              (@HSub.hSub Real Real Real (@instHSub Real Real.instSub) z
                (@HDiv.hDiv Real Real Real (@instHDiv Real (@DivInvMonoid.toDiv Real Real.instDivInvMonoid)) (↑v)
                  (@OfNat.ofNat Real (nat_lit 2) (@instOfNatAtLeastTwo Real (nat_lit 2) Real.instNatCast ⋯))))))
          stock))
    (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero))
M2Calibration.integrated_variance_affine (n : Nat) (floorPart floor t : Real) (A xi eta : Fin n → Real) :
  @Eq Real
    (integratedVariance n floorPart floor A fun i =>
      @HAdd.hAdd Real Real Real (@instHAdd Real Real.instAdd)
        (@HMul.hMul Real Real Real (@instHMul Real Real.instMul)
          (@HSub.hSub Real Real Real (@instHSub Real Real.instSub)
            (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne)) t)
          (xi i))
        (@HMul.hMul Real Real Real (@instHMul Real Real.instMul) t (eta i)))
    (@HAdd.hAdd Real Real Real (@instHAdd Real Real.instAdd)
      (@HMul.hMul Real Real Real (@instHMul Real Real.instMul)
        (@HSub.hSub Real Real Real (@instHSub Real Real.instSub)
          (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne)) t)
        (integratedVariance n floorPart floor A xi))
      (@HMul.hMul Real Real Real (@instHMul Real Real.instMul) t (integratedVariance n floorPart floor A eta)))
M2Calibration.finite_noise_square_decomposition (n : Nat) (p noise : Fin n → Real) (a : Real)
  (hmass : @Eq Real (∑ i, p i) (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne)))
  (hmean :
    @Eq Real (∑ i, @HMul.hMul Real Real Real (@instHMul Real Real.instMul) (p i) (noise i))
      (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero))) :
  @Eq Real
    (∑ i,
      @HMul.hMul Real Real Real (@instHMul Real Real.instMul) (p i)
        (@HPow.hPow Real Nat Real (@instHPow Real Nat (@NPow.toPow Real (@Monoid.toNPow Real Real.instMonoid)))
          (@HAdd.hAdd Real Real Real (@instHAdd Real Real.instAdd) a (noise i))
          (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))))
    (@HAdd.hAdd Real Real Real (@instHAdd Real Real.instAdd)
      (@HPow.hPow Real Nat Real (@instHPow Real Nat (@NPow.toPow Real (@Monoid.toNPow Real Real.instMonoid))) a
        (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
      (∑ i,
        @HMul.hMul Real Real Real (@instHMul Real Real.instMul) (p i)
          (@HPow.hPow Real Nat Real (@instHPow Real Nat (@NPow.toPow Real (@Monoid.toNPow Real Real.instMonoid)))
            (noise i) (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))))
