'M2Wing.portfolio_moment_obstruction' depends on axioms: [propext, Classical.choice, Quot.sound]
M2Wing.portfolio_moment_obstruction.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : @Measure Ω inst✝) (X P : Ω → Real)
  (budget cost : Real)
  (hX :
    @Integrable Real
      (@UniformSpace.toTopologicalSpace Real (@PseudoMetricSpace.toUniformSpace Real Real.pseudoMetricSpace))
      (@ESeminormedAddMonoid.toContinuousENorm Real
        (@UniformSpace.toTopologicalSpace Real (@PseudoMetricSpace.toUniformSpace Real Real.pseudoMetricSpace))
        (@SeminormedAddGroup.toESeminormedAddMonoid Real
          (@SeminormedAddCommGroup.toSeminormedAddGroup Real
            (@NonUnitalSeminormedRing.toSeminormedAddCommGroup Real
              (@NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing Real
                (@SeminormedCommRing.toNonUnitalSeminormedCommRing Real
                  (@NormedCommRing.toSeminormedCommRing Real Real.normedCommRing)))))))
      Ω inst✝
      (fun ω =>
        @HPow.hPow Real Nat Real (@instHPow Real Nat (@NPow.toPow Real (@Monoid.toNPow Real Real.instMonoid))) (X ω)
          (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
      μ)
  (hP :
    @Integrable Real
      (@UniformSpace.toTopologicalSpace Real (@PseudoMetricSpace.toUniformSpace Real Real.pseudoMetricSpace))
      (@ESeminormedAddMonoid.toContinuousENorm Real
        (@UniformSpace.toTopologicalSpace Real (@PseudoMetricSpace.toUniformSpace Real Real.pseudoMetricSpace))
        (@SeminormedAddGroup.toESeminormedAddMonoid Real
          (@SeminormedAddCommGroup.toSeminormedAddGroup Real
            (@NonUnitalSeminormedRing.toSeminormedAddCommGroup Real
              (@NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing Real
                (@SeminormedCommRing.toNonUnitalSeminormedCommRing Real
                  (@NormedCommRing.toSeminormedCommRing Real Real.normedCommRing)))))))
      Ω inst✝ P μ)
  (hdom :
    ∀ (ω : Ω),
      @LE.le Real Real.instLE (P ω)
        (@HPow.hPow Real Nat Real (@instHPow Real Nat (@NPow.toPow Real (@Monoid.toNPow Real Real.instMonoid))) (X ω)
          (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))))
  (hcost :
    @LE.le Real Real.instLE cost
      (@integral Ω Real Real.normedAddCommGroup
        (@InnerProductSpace.toNormedSpace Real Real Real.instRCLike
          (@NormedAddCommGroup.toSeminormedAddCommGroup Real Real.normedAddCommGroup)
          (@RCLike.toInnerProductSpaceReal Real Real.instRCLike))
        inst✝ μ fun ω => P ω))
  (hbudget :
    @Eq Real
      (@integral Ω Real Real.normedAddCommGroup
        (@InnerProductSpace.toNormedSpace Real Real Real.instRCLike
          (@NormedAddCommGroup.toSeminormedAddCommGroup Real Real.normedAddCommGroup)
          (@RCLike.toInnerProductSpaceReal Real Real.instRCLike))
        inst✝ μ fun ω =>
        @HPow.hPow Real Nat Real (@instHPow Real Nat (@NPow.toPow Real (@Monoid.toNPow Real Real.instMonoid))) (X ω)
          (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
      budget) :
  @LE.le Real Real.instLE cost budget
