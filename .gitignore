# Python cache and local artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.ipynb_checkpoints/

# OS/editor noise
.DS_Store
Thumbs.db

# Local generated web exports under matteo/web_claude
matteo/web_claude/*.html
matteo/web_claude/*.json

# Keep the M2 research package; all other direct matteo subfolders are local material.
/matteo/*/
!/matteo/exogenous_reservoir_eq_m2/
!/matteo/exogenous_reservoir_eq_m2/**
!/matteo/preprocessing/
!/matteo/preprocessing/**
!/matteo/model_comparison/
!/matteo/model_comparison/**
/matteo/preprocessing/**/__pycache__/
/matteo/model_comparison/**/__pycache__/
**/.DS_Store

# Re-ignore local build intermediates after keeping the M2 package visible.
/matteo/exogenous_reservoir_eq_m2/**/__pycache__/
/matteo/exogenous_reservoir_eq_m2/**/*.egg-info/
/matteo/exogenous_reservoir_eq_m2/documentation/*.aux
/matteo/exogenous_reservoir_eq_m2/documentation/*.out
/matteo/exogenous_reservoir_eq_m2/documentation/*.toc

# Common local logs
*.log

# Locally supplied market datasets
/data/raw/
/data/processed/

# Local numerical caches remain on disk; preserve compact run records in Git.
/matteo/model_comparison/option_pricing/runs/**/*.npy
/matteo/model_comparison/option_pricing/runs/**/*.npz

# Regenerable compiler, test and PDF-review intermediates.
*.dylib
*.olean
*.ilean
.pytest_cache/
.ruff_cache/
/tmp/
/matteo/model_comparison/othmane_docs_20261026.prepared/
**/model_comparison/option_pricing/formalization/
**/model_comparison/option_pricing/literature/

# Raw correspondence is local reference material, not a research export.
/matteo/model_comparison/option_pricing/runs/m2_vix_design_research_001/email*

# Committed ancestors and RECOVERY_MANIFEST identify these same historical bytes.
/docs/research/archive/*/missing_tracked_evidence_HEAD.zip
/docs/research/archive/*/evidence_snapshot.zip
/docs/research/archive/*/git_status_before.bin
/docs/research/checks/

# Keep small scientific execution/audit logs alongside their run records.
!/matteo/model_comparison/option_pricing/runs/**/*.log
/matteo/model_comparison/option_pricing/runs/**/execution_live.log
